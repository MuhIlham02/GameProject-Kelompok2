[sub_resource type="GDScript" id="GDScript_6ib6r"]
script/source = "extends CharacterBody2D

# Memanggil node animasi (pastikan namanya persis \"Sprite2D\" sesuai di panel Scene kiri Anda)
@onready var animasi = $Sprite2D

func _physics_process(_delta):
	var arah = Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\")
	velocity = arah * 150
	move_and_slide()

	# Logika mengubah arah hadap gambar
	if arah.x > 0:
		animasi.play(\"idle_kanan\")
	elif arah.x < 0:
		animasi.play(\"idle_kiri\")
	elif arah.y > 0:
		animasi.play(\"idle_bawah\")
	elif arah.y < 0:
		animasi.play(\"idle_atas\")
"

